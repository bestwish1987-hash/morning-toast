# ============================================================
#  🍞 morning-toast 環境變數範本
# ============================================================
#  ⚠️  此檔案僅作說明用,實際部署請填入 GitHub Secrets
#     (Settings → Secrets and variables → Actions)
#  ⚠️  本地測試請複製為 .env 並填入真實值,絕對不要 commit .env
# ============================================================


# ─── LINE Messaging API ──────────────────────────────────────
# 取得方式:
#   1. 到 https://developers.line.biz/ 登入
#   2. Create a new provider → Create a Messaging API channel
#   3. Basic settings → Channel access token → Issue
# ────────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 取得方式:
#   1. 把你的 Bot 加為 LINE 好友(或加入群組)
#   2. 在群組裡發任何訊息
#   3. 到 LINE Developers Console → Webhook → 看 webhook 收到的 groupId
#   個人:Uxxxxx...  /  群組:Cxxxxx...  /  聊天室:Rxxxxx...
# ────────────────────────────────────────────────────────────
MORNING_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Anthropic Claude API ────────────────────────────────────
# 取得方式:
#   1. 到 https://console.anthropic.com/ 註冊
#   2. Settings → API Keys → Create Key
#   3. 註冊送一些免費額度,之後一個月約 USD $0.30
# ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Unsplash 圖庫 ───────────────────────────────────────────
# 取得方式:
#   1. 到 https://unsplash.com/developers 註冊
#   2. New Application → 填基本資料 → 取得 Access Key
#   3. 免費版每小時 50 次,每天用一次完全夠
# ────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here


# ─── Cloudinary 圖片託管 ─────────────────────────────────────
# 取得方式:
#   1. 到 https://cloudinary.com/ 註冊
#   2. Dashboard 上會看到 Cloud Name、API Key、API Secret
#   3. 免費版每月 25GB 流量,每天一張完全夠
# ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
